# ---- FREE options only ----
# Provider: ollama | groq | google
# Shared by Agent-1 (answer generator) and Agent-2 (claim detector).

# Option 1 (recommended / default): Groq free tier (fast, needs a free key from console.groq.com)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_free_key_here

# Option 2: Ollama - 100% free, runs on your laptop, no API key, works offline
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# Option 3: Google Gemini free tier (free key from aistudio.google.com)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your_free_key_here

# ---- Agent-3 (trust scorer) ----
# Free key at tavily.com, used by the web_search tool to find evidence for each claim.
TAVILY_API_KEY=your_free_key_here
